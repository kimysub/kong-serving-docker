# =============================================================================
# Kong Gateway Docker Compose — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# =============================================================================

# -- Kong version -------------------------------------------------------------
KONG_VERSION=3.9.1

# -- PostgreSQL ---------------------------------------------------------------
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
# Password is stored in the POSTGRES_PASSWORD file (Docker secret).

# -- Host port mappings -------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
POSTGRES_PORT=5432

# -- LLM backend URLs --------------------------------------------------------
# Single backend (direct proxy):
#   VLLM_UPSTREAM_URL=http://host.docker.internal:8080
#
# Load balanced (comma-separated, round-robin):
#   VLLM_UPSTREAM_URL=http://gpu1:8080,http://gpu2:8080,http://gpu3:8080
#
# NOTE: Kong proxy defaults to port 8000. If vLLM also uses 8000, change one.

VLLM_UPSTREAM_URL=http://host.docker.internal:8080
SGLANG_UPSTREAM_URL=http://host.docker.internal:30000

# For additional backends beyond vLLM and SGLang, see config/backends.conf.example

# -- Admin API key ------------------------------------------------------------
# Used by the key-auth plugin to protect the /admin-api route.
# CHANGE THIS in production!
KONG_ADMIN_API_KEY=changeme-admin-key-secret
